# PentAGI environment template — copy to .env and fill in real values.
#   cp .env.example .env
# NEVER commit a filled .env. All values below are EMPTY placeholders.
#
# At least ONE LLM provider key is REQUIRED or PentAGI will not run agents.

# ---- LLM providers (at least one required) ----
OPEN_AI_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# AWS Bedrock (all three, if used)
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_REGION=
BEDROCK_DEFAULT_MODEL=
DEEPSEEK_SERVER_URL=
DEEPSEEK_MODEL=
# Ollama (local/self-hosted models)
OLLAMA_SERVER_URL=
OLLAMA_SERVER_MODEL=
# Custom OpenAI-compatible endpoint
LLM_SERVER_URL=
LLM_SERVER_KEY=
LLM_SERVER_MODEL=

# ---- Database (defaults point at the bundled pgvector service) ----
# Leave empty to use the compose default built from the PENTAGI_POSTGRES_* values.
DATABASE_URL=
PENTAGI_POSTGRES_USER=pentagi
# REQUIRED: set a long random password, e.g. openssl rand -hex 24
PENTAGI_POSTGRES_PASSWORD=
PENTAGI_POSTGRES_DB=pentagidb

# ---- Web / security ----
# REQUIRED: long random salt, e.g. openssl rand -hex 32
COOKIE_SIGNING_SALT=
# Public URL users reach PentAGI at, e.g. https://pentagi.example.com
PUBLIC_URL=
CORS_ORIGINS=
SERVER_PORT=8443
SERVER_USE_SSL=true

# ---- Listening (compose) ----
# Keep 127.0.0.1 unless a reverse proxy on this host terminates TLS for you.
PENTAGI_LISTEN_IP=127.0.0.1
PENTAGI_LISTEN_PORT=8443

# ---- Optional ----
INSTALL_ID=
SCRAPER_PUBLIC_URL=

# After first start, log in at https://<host>:8443 with the default
# admin@pentagi.com / admin and CHANGE THE PASSWORD IMMEDIATELY.
